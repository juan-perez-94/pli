---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import MakeRoom from '../components/sections/MakeRoom.astro';
import Letters from '../components/sections/Letters.astro';
import SmallMoments from '../components/sections/SmallMoments.astro';
import Reassurance from '../components/sections/Reassurance.astro';
import ReserveBand from '../components/sections/ReserveBand.astro';
import Faq from '../components/sections/Faq.astro';
import ReservationBar from '../components/sections/ReservationBar.astro';
---

<Layout>
  <main class="page">
    <Hero />
    <HowItWorks />
    <MakeRoom />
    <Letters />
    <SmallMoments />
    <Reassurance />
    <ReserveBand />
    <Faq />
  </main>
  <ReservationBar />
</Layout>

<style>
  /* Vertical rhythm between sections, from the Figma frame. */
  .page {
    display: flex;
    flex-direction: column;
    padding-bottom: calc(var(--section-gap-s) + 114px); /* room for the reservation bar */
  }
  .page > :global(* + *) {
    margin-top: var(--section-gap);
  }
  .page > :global(.how) {
    margin-top: clamp(var(--space-8), 15.7vw, 226px);
  }
  .page > :global(.room) {
    margin-top: clamp(6rem, 24vw, 22rem);
  }
  .page > :global(.letters) {
    margin-top: clamp(6rem, 27.6vw, 25rem);
  }
  .page > :global(:has(.band)) {
    margin-top: var(--section-gap-s);
  }
  .page > :global(.faq) {
    margin-top: clamp(6rem, 15.6vw, 225px);
  }
</style>
