---
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/figma/hero-photo.jpg';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Logo from '../ui/Logo.astro';
import MetaList from '../ui/MetaList.astro';
import { PILOT } from '../../config';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="poster">
    <Image
      class="poster__photo"
      src={heroPhoto}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(min-width: 960px) 393px, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <Logo class="poster__logo" tone="white" width={150} />
    <p class="poster__title" aria-hidden="true">Letters <em>for two.</em></p>
  </div>

  <div class="copy">
    <div class="copy__chips">
      <Chip tone="ink">{PILOT.edition}</Chip>
      <Chip>{PILOT.season}</Chip>
    </div>
    <h1 id="hero-title" class="copy__title t-display-xl">
      Your love story deserves more than wedding photos.
    </h1>
    <p class="t-lede">
      Three letters you each write alone and open together. <em
        >Three evenings to stop planning and really look at the person you’re marrying.</em
      >
    </p>
    <div class="copy__cta" data-hero-cta>
      <Button location="hero" block>Reserve your place</Button>
      <MetaList items={[`${PILOT.price} per couple`, PILOT.seats, PILOT.firstLetter]} />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 393fr) minmax(0, 744fr);
    column-gap: calc(103 / 1240 * 100%);
    align-items: center;
    padding-top: clamp(var(--space-5), 5.97vw, 86px);
  }

  /* Poster: the phone-shaped photo card on the left. */
  .poster {
    position: relative;
    aspect-ratio: 393 / 852;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-blush);
    color: var(--color-paper);
  }
  .poster__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 47% 40%;
    transform: scale(1.128);
  }
  .poster__logo {
    position: absolute;
    top: calc(107 / 852 * 100%);
    left: 50%;
    width: calc(150 / 393 * 100%);
    height: auto;
    translate: -50% 0;
  }
  .poster__title {
    position: absolute;
    left: calc(40 / 393 * 100%);
    bottom: calc(91 / 852 * 100%);
    font-family: var(--font-serif);
    /* 116.6px on a 393px card → scale with the card width */
    font-size: clamp(4rem, 8.1vw, 7.29rem);
    line-height: 0.87;
  }
  .poster__title em {
    display: block;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .copy__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .copy__title {
    margin-top: calc(var(--space-4) - var(--space-5));
    line-height: 1.3;
  }
  .copy__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    width: fit-content;
    max-width: 100%;
    margin-top: calc(var(--space-8) - var(--space-5));
  }

  @media (max-width: 959px) {
    .hero {
      grid-template-columns: 1fr;
      row-gap: var(--space-7);
    }
    .poster {
      aspect-ratio: 393 / 560;
      max-height: 78svh;
      width: 100%;
      border-radius: var(--radius-l);
    }
    .poster__photo {
      transform: none;
      object-position: 47% 30%;
    }
    .poster__logo {
      top: var(--space-7);
      width: 120px;
    }
    .poster__title {
      left: var(--space-6);
      bottom: var(--space-6);
      font-size: clamp(4rem, 18vw, 7.29rem);
    }
    .copy__cta {
      width: 100%;
    }
  }
</style>
