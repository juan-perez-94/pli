---
// Paper-like surface used for letters and the "how it works" illustration.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'article'> & { as?: 'article' | 'div' | 'figure' };
const { as: Tag = 'article', class: className, ...rest } = Astro.props;
---

<Tag class:list={['letter-card', className]} {...rest}><slot /></Tag>

<style>
  .letter-card {
    background: var(--color-letter);
    border: 1px solid var(--color-letter-edge);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-letter);
  }
</style>
